# GEO-SaaS 环境变量模板
# 用法：复制为 .env 并填入真实值（.env 已在 .gitignore 中，不会入库）
#   cp .env.example .env
#
# 【重要】本项目 Docker Compose 采用"端口在容器内"部署：
#   - 容器通过 geo-saas-net 网络按【服务名】互访，故以下 MYSQL_HOST / REDIS_HOST /
#     RABBITMQ_HOST 默认填 compose 服务名（mysql / redis / rabbitmq），不要用 localhost。
#   - 生产档案默认 prod（JWT_SECRET 缺失会 fail-fast 拒绝启动，安全设计）。
#   - 仅当你在宿主机本地跑后端（非容器、非 compose 网络）时才把 host 改回 localhost。

# ---------- 必填（生产环境缺失会导致启动失败）----------

# JWT 签名密钥，Base64 编码、解码后至少 32 字节
# 生成：openssl rand -base64 32
JWT_SECRET=

# 允许跨域访问的前端域名，多个用英文逗号分隔。禁止填 *
# 经 1Panel/反向代理对外时填对外域名；纯容器回环访问可留 http://localhost
CORS_ALLOWED_ORIGINS=http://localhost

# ---------- 数据库 ----------
MYSQL_HOST=mysql        # compose 服务名（容器内互访）
MYSQL_PORT=3306
MYSQL_DATABASE=geo_saas
MYSQL_USER=root
MYSQL_PASSWORD=         # 必填，须与 init.sql / compose 保持一致

# ---------- Redis ----------
REDIS_HOST=redis        # compose 服务名
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- RabbitMQ ----------
RABBITMQ_HOST=rabbitmq  # compose 服务名
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---------- 应用 ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod    # Docker 部署用 prod；本地非容器开发才改 dev
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ---------- 前端解耦构建变量（可选，前端构建时读取） ----------
# 默认同域部署（前端 Nginx 反代 /api 到容器内 backend:8080），无需配置。
# 仅当要前后端彻底解耦、前端独立托管时设置，指向后端真实可达地址：
#   VITE_API_BASE=http://<后端域名或IP>:8080
# 前端 dev 服务器反向代理目标（默认 http://localhost:8080）：
#   VITE_API_TARGET=http://localhost:8080

# ---------- AI 服务 ----------
# 留空且 AI_SIMULATION_ENABLED=true 时使用内置模拟数据，无需真实 Key
AI_SIMULATION_ENABLED=true
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
TONGYI_API_KEY=
DOUBAO_API_KEY=
# AI 调用超时（毫秒）
AI_CONNECT_TIMEOUT=5000
AI_READ_TIMEOUT=60000

# ---------- GEO 真实数据采集器（G-01，默认关闭）----------
# 启用后每日 01:30 定时从 AI 搜索源采集真实 mentionRate 等指标写入 data_monitor_stat。
# 至少启用一个引擎并填入 API Key；任何引擎失败只记日志不写库，绝不写入模拟数据。
GEO_COLLECTOR_ENABLED=false
GEO_COLLECTOR_BRANDS=
GEO_COLLECTOR_PROBES=3
GEO_COLLECTOR_TIMEOUT=20
# Perplexity 官方 API（https://docs.perplexity.ai）
GEO_PERPLEXITY_ENABLED=false
GEO_PERPLEXITY_API_KEY=
GEO_PERPLEXITY_API_URL=https://api.perplexity.ai/chat/completions
GEO_PERPLEXITY_MODEL=sonar
# OpenAI 兼容网关（通义/豆包/DeepSeek 等）
GEO_OPENAI_COMPAT_ENABLED=false
GEO_OPENAI_COMPAT_API_KEY=
GEO_OPENAI_COMPAT_API_URL=
GEO_OPENAI_COMPAT_MODEL=
